# Kopyahin bilang .env at palitan ang password (katulad ng nasa devops/.env)
DATABASE_URL=postgres://auth:palitan-mo-ito@localhost:5435/auth_learning

# Gumawa ng sariling secret:  openssl rand -base64 48
JWT_SECRET=palitan-ng-openssl-rand-base64-48

# Ang frontend na pinapayagang tumawag dito (CORS) — isang tiyak na origin, hindi *
CLIENT_URL=http://localhost:5173

# true LANG sa production sa likod ng Cloudflare Tunnel (walang bukas na port ang backend)
# — para bawat totoong IP ang bilang ng rate limiter (CF-Connecting-IP)
TRUST_CLOUDFLARE=false
