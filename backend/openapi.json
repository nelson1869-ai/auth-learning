  "info": {
    "title": "auth-learning API",
    "version": "1.0.0",
    "description": "Ginagawa mula sa Zod schemas ng backend (Day 78). Ang lahat ng POST mula sa browser ay dapat galing sa frontend (Origin check, Day 44)."
