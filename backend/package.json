    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "private": true,
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "nodemon": "^3.1.14",
    "oxlint": "^1.85.0",
    "supertest": "^7.3.0",
    "vitest": "^5.0.2"
  }
