{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API ng auth-learning (Express)",
  "scripts": {
    "test": "vitest run",
    "dev": "nodemon --watch src --watch .env --ext ts,json,env --exec \"node --env-file=.env src/index.ts\"",
    "start": "node --env-file=.env src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:migrate:test": "node --env-file=.env.test node_modules/drizzle-kit/bin.cjs migrate",
    "lint": "oxlint src",
    "typecheck": "tsc",
    "db:migrate:prod": "node --env-file=.env.production src/db/migrate.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "private": true,
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "nodemon": "^3.1.14",
    "oxlint": "^1.85.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
