  "description": "Backend API ng auth-learning (Express)",
  "scripts": {
    "test": "vitest run",
    "dev": "nodemon --watch src --watch .env --ext js,json,env --exec \"node --env-file=.env src/index.js\"",
    "start": "node --env-file=.env src/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:migrate:test": "node --env-file=.env.test node_modules/drizzle-kit/bin.cjs migrate",
    "lint": "oxlint src"
  },
