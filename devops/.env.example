# Kopyahin bilang .env at lagyan ng sariling password (huwag i-commit ang .env)
POSTGRES_PASSWORD=palitan-mo-ito

# Grafana admin password (Day 82) — mahaba at random, hal.: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=palitan-mo-ito

# Alertmanager (Day 84) — kung saan ipapadala ang alert email, at ang Resend API key (SMTP password).
# Mas mabuti: isang hiwalay na Resend key na "Sending access" lang, para sa nelson1869.com
ALERT_EMAIL_TO=ikaw@example.com
ALERT_SMTP_PASSWORD=re_palitan-mo-ito
